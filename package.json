{
  "name": "ia_workspaces",
  "productName": "ia_workspaces",
  "version": "1.1.0",
  "description": "Workspace-oriented terminal for Windows, macOS and Linux: vertical workspace tabs, terminal tabs with split panes, themes, and agent notifications.",
  "main": "out/electron/main/main.js",
  "author": "aombk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch --electron",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "package": "node build.mjs && electron-builder && node tools/collect.mjs",
    "package:win": "node build.mjs && electron-builder --win && node tools/collect.mjs",
    "package:mac": "node build.mjs && electron-builder --mac && node tools/collect.mjs",
    "package:linux": "node build.mjs && electron-builder --linux && node tools/collect.mjs",
    "collect": "node tools/collect.mjs",
    "changelog": "node tools/collect-changelog.mjs",
    "release": "node tools/release.mjs",
    "clean": "node tools/clean.mjs",
    "icon": "node tools/make-icon.mjs --ico",
    "installer:images": "powershell -ExecutionPolicy Bypass -File tools/make-installer-images.ps1"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "dev.iaworkspaces.terminal",
    "productName": "ia_workspaces",
    "extraMetadata": {
      "description": "ia_workspaces"
    },
    "directories": {
      "output": "out/electron-pack"
    },
    "afterPack": "tools/stampExe.mjs",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "out/electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**",
      "out/electron/cli/**",
      "out/electron/host/**"
    ],
    "extraResources": [
      {
        "from": "packaging/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "packaging/icons/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "dir"
      ]
    },
    "mac": {
      "icon": "packaging/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.inherit.plist",
      "x64ArchFiles": "macsensors",
      "signIgnore": [
        "\\.pak$"
      ],
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "icon": "packaging/icons",
      "category": "Development",
      "target": [
        "AppImage",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
